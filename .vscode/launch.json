{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node-terminal",
            "request": "launch",
            "name": "startdebug",
            // ⚡ 核心修复：在 -cp 里追加了 :./target/dependency/*，这是 Maven 导出依赖的黄金路径
            "command": "./jdk/bin/java -server -agentlib:jdwp=transport=dt_socket,server=y,suspend=y,address=5005 -cp \"./target/classes:./target/test-classes:./bin:./out:./lib/*:./libs/*:./target/dependency/*:./config:./scripts\" -DhomePath=./config/ -DscriptsPath=./scripts/ -DwzPath=./scripts/wz -Xms512m -Xmx2048m -XX:PermSize=256m -XX:MaxPermSize=512m -XX:MaxNewSize=512m server.Start",
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "java",
            "request": "attach",
            "name": "attach_src",
            "hostName": "127.0.0.1",
            "port": 5005,
            "timeout": 30000,
            "sourcePaths": [
                "${workspaceFolder}/src",
                "${workspaceFolder}"
            ]
        }
    ],
    "compounds": [
        {
            "name": "一键用 Java 1.7 调试源码",
            "configurations": [
                "startdebug",
                "attach_src"
            ]
        }
    ]
}
